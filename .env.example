# ─── Database ──────────────────────────────────────────────────────────────────
POSTGRES_DB=qagent
POSTGRES_USER=qagent
POSTGRES_PASSWORD=change_me_in_production

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── AI Provider Keys ──────────────────────────────────────────────────────────
# Required: at least one AI provider key
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...                   # optional fallback

# ─── App Security ──────────────────────────────────────────────────────────────
SECRET_KEY=generate_a_64_char_random_string_here
ENVIRONMENT=development                  # development | staging | production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ─── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ─── File Storage ──────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
REPORTS_DIR=./reports
MAX_UPLOAD_SIZE_MB=50

# ─── AI Model Configuration ────────────────────────────────────────────────────
AI_MODEL=claude-sonnet-4-6              # primary model
AI_MODEL_FAST=claude-haiku-4-5-20251001 # fast/cheap tasks
AI_TEMPERATURE=0.1                       # low = deterministic
AI_MAX_TOKENS=8192

# ─── Vector DB ─────────────────────────────────────────────────────────────────
# Using pgvector (built-in). For Pinecone:
# PINECONE_API_KEY=
# PINECONE_INDEX=qagent

# ─── Test Execution ─────────────────────────────────────────────────────────────
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_SLOW_MO=0
PLAYWRIGHT_TIMEOUT=30000
SCREENSHOT_ON_FAILURE=true
VIDEO_ON_FAILURE=true

# ─── Celery Flower (monitoring UI, only with --profile monitoring) ─────────────
FLOWER_USER=admin
FLOWER_PASSWORD=changeme_in_production

# ─── Email Notifications (optional) ────────────────────────────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# FROM_EMAIL=noreply@yourcompany.com
